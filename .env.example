# ═══════════════════════════════════════════════════════════════════════════════
# Akshara Annotation Platform — Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit your real .env to Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Akshara Annotation Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"    # production | development
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (PostgreSQL only — SQLite is NOT supported)
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=""

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development: "http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
# Production:  "https://akshara-annotation-platform.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ── Task Locking ──────────────────────────────────────────────────────────────
TASK_LOCK_TIMEOUT_MINUTES=30
TASK_LOCK_HEARTBEAT_INTERVAL_SECONDS=60

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""         # Safe for frontend — limited access
SUPABASE_SERVICE_KEY=""      # NEVER expose to frontend — server-side only (Render)

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BUCKET="audio-files"
AUDIO_URL_EXPIRY_SECONDS=3600    # Signed URL lifetime (1 hour)
